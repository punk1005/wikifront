    location /wiki/uploads/ {
        # 1. Запрос авторизации в authfull
        auth_request /internal/auth/validate;

        alias /usr/local/sbin/cicd/scripts/services/wikifront/uploads/; # путь к папке с файлами
        add_header Content-Disposition "attachment";
    }
    location /wiki/ {

        # 1. Запрос авторизации в authfull
        auth_request /internal/auth/validate; 

        # 2. КРИТИЧНО: Перехватываем заголовки из ответа Go (через $upstream_http_...)
        auth_request_set $user_id $upstream_http_x_user_id;
        auth_request_set $user_roles $upstream_http_x_user_roles;
        auth_request_set $user_perms $upstream_http_x_user_permissions;
       
        proxy_pass http://127.0.0.1:${WIKI_PORT}/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }